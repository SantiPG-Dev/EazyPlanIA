<?xml version="1.0" encoding="UTF-8"?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.eazyplan.presentation.controllers.DashboardController"
      alignment="CENTER" spacing="24">

    <padding>
        <Insets top="60" right="40" bottom="60" left="40"/>
    </padding>

    <Text text="EazyPlanIA" style="-fx-font-size: 32px; -fx-font-weight: bold;" />
    <Label fx:id="welcomeLabel" text="Welcome" style="-fx-font-size: 16px; -fx-text-fill: #888;" />

    <VBox spacing="16" alignment="CENTER">
        <Button text="🏋️ Rutinas" fx:id="workoutButton" onAction="#goToWorkout" prefWidth="220" prefHeight="50"
                style="-fx-font-size: 16px;"/>
        <Button text="🛒 Lista de Compras" fx:id="groceryButton" onAction="#goToGroceryList" prefWidth="220" prefHeight="50"
                style="-fx-font-size: 16px;"/>
        <Button text="🥗 Dietas" fx:id="dietButton" onAction="#goToDiet" prefWidth="220" prefHeight="50"
                style="-fx-font-size: 16px;"/>
    </VBox>

    <Button text="Cerrar sesión" onAction="#logout" style="-fx-text-fill: #d9534f; -fx-font-size: 12px;"/>

</VBox>
