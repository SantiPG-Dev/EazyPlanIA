<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.geometry.Insets?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.eazyplan.presentation.controllers.GroceryListController">

    <padding>
        <Insets top="20" right="30" bottom="20" left="30"/>
    </padding>

    <!-- Header -->
    <HBox spacing="16" alignment="CENTER_LEFT" style="-fx-background-color: #f5f5f5; -fx-padding: 12;">
        <Button text="← Back" onAction="#goBack"/>
        <Label text="Listas de Compras" style="-fx-font-size: 22px; -fx-font-weight: bold;" />
        <Button text="+ Nueva Lista" fx:id="newGroceryButton" onAction="#handleNewGrocery"/>
    </HBox>

    <!-- Grocery lists -->
    <ListView fx:id="groceryListsView" VBox.vgrow="ALWAYS"/>

</VBox>
